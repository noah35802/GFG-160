class Solution:
    def countSum(self, arr, target):
        #code here
        n = len(arr)
        count = 0
        m = defaultdict(int)
        for i in range(n-1):
            for j in range(i+1, n):
                temp = arr[i] + arr[j]
                count += m[target - temp]
            for j in range(i):
                temp = arr[i] + arr[j]
                m[temp] += 1
                
        return count
