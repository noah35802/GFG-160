#User function Template for python3
class Solution:
	def countPairs(self, arr, k):
    	# code here
    	freq = {}
    	count = 0
    	for num in arr:
    	    freq[num]= freq.get(num, 0) + 1
    	    
        for num in arr:
            if num + k in freq:
                count += freq[num + k]
            if num - k in freq:
                count += freq[num -k]
            freq[num] -= 1
            
        return count




