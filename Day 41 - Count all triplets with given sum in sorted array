class Solution:
    def countTriplets(self, arr, target):
        # code here
        c = 0
        n = len(arr)

        if n < 3:
            return 0

        for i in range(n - 2):
            left = i + 1
            right = n - 1

            while left < right:
                sum_triplet = arr[i] + arr[left] + arr[right]

                if sum_tariplet == target:
                    if arr[left] == arr[right]:
                        count = right - left + 1
                        c += (count * (count - 1)) // 2
                        break
                    else:
                        count_left = 1
                        while left + 1 < right and arr[left] == arr[left + 1]:
                            count_left += 1
                            left += 1

                        count_right = 1
                        while right - 1 > left and arr[right] == arr[right - 1]:
                            count_right += 1
                            right -= 1

                        c += count_left * count_right
                        left += 1
                        right -= 1
                elif sum_triplet < target:
                    left += 1
                else:
                    right -= 1

        return c
