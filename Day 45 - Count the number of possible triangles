class Solution:
    #Function to count the number of possible triangles.
    def countTriangles(self, arr):
        # code here
        count = 0
        n = len(arr)
        arr.sort()
    
        for k in range(2, n):
            i = 0
            j = k - 1
        
            while i < j:
                if arr[i] + arr[j] > arr[k]:
                    count += (j - i)
                    j -= 1
                else:
                    i += 1
    
        return count
