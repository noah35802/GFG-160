class Solution:
    def findMinOperation(self, mat):
        # code here
        n = len(mat)
        res = 0
        rsum = [0] * n
        csum = [0] * n
        msum = 0
        
        for i in range(n):
            for j in range(n):
                rsum[i] += mat[i][j]
                csum[j] += mat[i][j]
                
        msum = max(max(rsum), max(csum))
        
        for i in range(n):
            res += msum - rsum[i]
            
        return res
