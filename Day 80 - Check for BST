class Solution:
    
    #Function to check whether a Binary Tree is BST or not.
    def isBST(self, root):
        #code here
        def bst(node, low, high):
            if not node:
                return True
            if node.data <= low or node.data >= high:
                return False
            return bst(node.left, low, node.data) and bst(node.right, node.data, high)
            
        return bst(root, float('-inf'), float('inf'))
