class Solution:
    def maxWater(self, arr):
        # code here
        left, right = 0, len(arr) - 1
        max_water = 0
        while left < right:
            width = right - left
            height = min(arr[left], arr[right])
            max_water = max(max_water, width * height)
            if arr[left] < arr[right]:
                left += 1
            else:
                right -= 1
        return max_water
