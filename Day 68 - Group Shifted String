class Solution:
    def groupShiftedString(self, arr):
        #code here
        def shift_key(s):
            return tuple((ord(s[i]) - ord(s[0])) % 26 for i in range(len(s)))
        groups = {}
        for s in arr:
            key = shift_key(s)
            if key not in groups:
                groups[key] = []
            groups[key].append(s)
        return list(groups.values())
