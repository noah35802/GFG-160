class Solution:
    def subarraySum(self, arr, target):
        # code here
        
        left = 0
        count = 0
        
        for right in range(len(arr)):
            count += arr[right]
            
            while count > target:
                count -= arr[left]
                left += 1
            
            if count == target:
                return [left + 1, right + 1]
        
        return [-1]
