class Solution:
    #Function to find equilibrium point in the array.
    def findEquilibrium(self, arr):
        # code here
        total = sum(arr)
        left_sum = 0
        
        for i in range(len(arr)):
            total -= arr[i]
            
            if left_sum == total:
                return i
                
            left_sum += arr[i]
        
        return -1
