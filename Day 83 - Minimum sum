class Solution:
    def addNumbers(self, l1,l2):
        i = len(l1)-1
        j = len(l2) - 1
        carry = 0
        res = []
        
        while i >= 0 or j >= 0 or carry > 0:
            total = carry
            
            if i >= 0:
                total = total + l1[i]
                
            if j >= 0:
                total = total + l2[j]
                
            res.append(str(total%10))
            carry = total // 10
            i = i-1
            j = j-1
            
        while len(res) > 0 and res[-1] == '0':
            res.pop()
        res = res[::-1]
        return ''.join(res)
                
        
    def minSum(self, arr):
        # code here
        arr.sort()
        l1 = []
        l2 = []
        
        for i in range(len(arr)):
            if i % 2 == 0:
                l1.append(arr[i])
            else:
                l2.append(arr[i])
                
        return self.addNumbers(l1,l2)
