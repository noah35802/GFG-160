class Solution:
    def longestUniqueSubstr(self, s):
        # code here
        j = 0
        ans = 0
        st = set()
        for i in range(len(s)):
            while s[i] in st:
                st.remove(s[j])
                j += 1
            st.add(s[i])
            ans = max(ans, len(st))
        return ans

