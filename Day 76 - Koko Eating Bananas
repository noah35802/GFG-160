class Solution:
    def kokoEat(self,arr,k):
        # Code here
        def canFinish(speed):
            hours = 0
            for pile in arr:
                hours += (pile + speed - 1) // speed
            return hours <= k
            
        left, right = 1, max(arr)
        result = right
        
        while left <= right:
            mid = (left + right) // 2
            if canFinish(mid):
                result = mid
                right = mid - 1
            else:
                left = mid + 1
                
        return result
